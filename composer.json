{
  "name": "codenson/daraja-api",
  "description": "A comprehensive Laravel package for Safaricom Daraja APIs - M-PESA integration made easy",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Codenson",
      "email": "kimanthidennis02@gmail.com.com"
    }
  ],
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3",
    "illuminate/support": "*",
    "guzzlehttp/guzzle": "^7.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0|^10.0",
    "orchestra/testbench": "^7.0|^8.0|^9.0",
    "mockery/mockery": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Codenson\\Daraja\\": "src/"
    },
    "files": [
      "src/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Codenson\\Daraja\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Codenson\\Daraja\\DarajaServiceProvider"
      ],
      "aliases": {
        "Daraja": "Codenson\\Daraja\\Facades\\Daraja"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}